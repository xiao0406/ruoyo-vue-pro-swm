<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jeesite.modules.swm.dao.SwmAreaDao">
    
    <!-- 查询数据 -->
    <select id="findList" resultType="com.jeesite.modules.entity.SwmArea">
        SELECT ${sqlMap.column.toSql()}
        FROM ${sqlMap.table.toSql()}
        <where>
            ${sqlMap.where.toSql()}
            <if test="random != null and random != 0">
                AND #{random} = #{random}
            </if>
        </where>
        ORDER BY ${sqlMap.order.toSql()}
    </select>
    <select id="findAddressList" resultType="com.jeesite.modules.entity.AiDto$Trajectory">
        SELECT
            sbs.location as address,
            sa.area_name
        FROM
            swm_beacon_station sbs
                Left JOIN swm_area sa ON sbs.area = sa.id
        WHERE
            sbs.`status` = 0
          AND sa.status = 0
          AND sbs.location IS NOT NULL
          AND TRIM(sbs.location) != ''
        order by sbs.location
    </select>

</mapper> 