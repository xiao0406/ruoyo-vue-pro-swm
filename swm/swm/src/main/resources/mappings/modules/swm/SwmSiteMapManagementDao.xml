<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jeesite.modules.swm.dao.SwmSiteMapManagementDao">
	
	<!-- 查询数据
	<select id="findList" resultType="SwmSiteMapManagement">
		SELECT ${sqlMap.column.toSql()}
		FROM ${sqlMap.table.toSql()}
		<where>
			${sqlMap.where.toSql()}
		</where>
		ORDER BY ${sqlMap.order.toSql()}
	</select> -->
	
	<!-- 更新底图状态 -->
	<update id="updateMapStatus">
		UPDATE `swm_site_map_management` 
		SET `status` = #{status}, 
		    `update_by` = #{updateBy}, 
		    `update_date` = #{updateDate} 
		WHERE `id` = #{id}
	</update>
	
	<!-- 物理删除底图 -->
	<delete id="physicalDelete">
		DELETE FROM `swm_site_map_management` WHERE `id` = #{id}
	</delete>
	
</mapper> 