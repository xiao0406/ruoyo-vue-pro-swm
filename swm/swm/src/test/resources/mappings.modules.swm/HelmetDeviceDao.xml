<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jeesite.modules.swm.dao.HelmetDeviceDao">
	
	<!-- 根据设备ID查询绑定人员身份证ID -->
	<select id="getAssignedPersonByDeviceId" resultType="String">
		SELECT assigned_person 
		FROM swm_helmet_device 
		WHERE device_id = #{deviceId} 
		AND status = '0';
	</select>
	
</mapper> 